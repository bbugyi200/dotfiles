{{- if eq .chezmoi.os "darwin" }}
# Keep command-line tools available in non-login SSH zsh sessions.
case ":${PATH}:" in
  *:/usr/local/bin:*) ;;
  *) PATH="/usr/local/bin:${PATH}" ;;
esac
case ":${PATH}:" in
  *:/opt/homebrew/bin:*) ;;
  *) PATH="/opt/homebrew/bin:${PATH}" ;;
esac
export PATH
{{ end }}
