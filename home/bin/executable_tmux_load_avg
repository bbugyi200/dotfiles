#!/bin/bash

##############################################################################
#  Print CPU and memory pressure, formatted for the tmux status line.        #
#                                                                            #
#  The output carries its own leading space and tmux style markup --         #
#  " #[fg=#828bb8]cpu #[default]40% #[fg=#828bb8]mem #[default]65%#[default]"#
#  -- so tmux.conf can append `#(tmux_load_avg)` directly after              #
#  `#(hostname)` and render `athena cpu 40% mem 65%` with the labels dimmed  #
#  and the numbers colored by pressure. `cpu` is uptime's 1-minute load      #
#  average divided by the number of online logical CPUs, rounded to a whole #
#  percent; it is load per core, not an instantaneous utilization sample,   #
#  and it may exceed 100% when more tasks are runnable than there are       #
#  cores. `mem` is current physical RAM usage, rounded to a whole percent.  #
#  Each metric is independent: a missing CPU count does not hide memory,    #
#  and a memory failure does not hide CPU. A healthy value inherits the     #
#  status line's color; `cpu` turns yellow at 80% and red at 100%; `mem`    #
#  turns yellow at 85% and red at 95%. With neither metric available this   #
#  prints nothing, so the status line degrades to a bare `athena`.          #
#                                                                            #
#  tmux runs this every `status-interval` (2s), so it deliberately does not  #
#  source ~/lib/bugyi.sh. Linux forks only `uptime`; macOS forks `uptime`,  #
#  one combined `sysctl`, and `vm_stat`.                                    #
#                                                                            #
#  The `uptime` wording differs by platform and both are matched here:       #
#    Linux: `... 3 users,  load average: 20.71, 24.19, 24.33`                #
#    macOS: `... 4 users, load averages: 3.36 3.26 2.94`                     #
##############################################################################

set -e

readonly STYLE_LABEL='fg=#828bb8'
readonly STYLE_WARN='fg=#ffc777'
readonly STYLE_CRIT='fg=#ff757f'
readonly STYLE_HEALTHY='default'

readonly CPU_WARN_THRESHOLD=80
readonly CPU_CRIT_THRESHOLD=100
readonly MEM_WARN_THRESHOLD=85
readonly MEM_CRIT_THRESHOLD=95

function usage() {
  cat <<EOM
usage: $(basename "$0") [-h]

Print CPU and memory pressure, decorated for the tmux status line as tmux
style markup: " #[fg=#828bb8]cpu #[default]40% #[fg=#828bb8]mem #[default]65%#[default]".
\`cpu\` is the 1-minute load average (from \`uptime\`) divided by the number of
online logical CPUs, rounded to a whole percent; it may exceed 100%. \`mem\` is
current physical RAM usage, rounded to a whole percent. Each metric is shown
only when it can be measured; with neither available this prints nothing.
Healthy values use the status line's default color. \`cpu\` turns yellow at
80% and red at 100%. \`mem\` turns yellow at 85% and red at 95%.

Optional Arguments
------------------
-h | --help
    View this help message.

Examples
--------
tmux_load_avg     # ' #[fg=#828bb8]cpu #[default]40% #[fg=#828bb8]mem #[default]65%#[default]'
tmux_load_avg     # ' #[fg=#828bb8]mem #[default]65%#[default]' when CPU is unavailable
EOM
}

function run() {
  if [[ -n "$1" ]]; then
    case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    *)
      printf 'error: unrecognized argument: %s\n\n' "$1" >&2
      usage >&2
      exit 2
      ;;
    esac
  fi

  local cpu='' mem=''

  case "${OSTYPE:-}" in
  linux*)
    collect_linux_metrics
    ;;
  darwin*)
    collect_darwin_metrics
    ;;
  *)
    ;;
  esac

  render_segment "${cpu}" "${mem}"
}

# Populates the `cpu` and `mem` variables from the caller's scope (`run`'s
# locals), since command substitution would drop assignments made in a
# subshell.
function collect_linux_metrics() {
  local load
  load="$(one_minute_load)" || load=''

  local cpus
  cpus="$(linux_cpu_count)" || cpus=''

  if [[ -n "${load}" && -n "${cpus}" ]]; then
    cpu="$(cpu_percent_from_load "${load}" "${cpus}")" || cpu=''
  fi

  mem="$(linux_memory_percent 2> /dev/null)" || mem=''
}

# Populates the `cpu` and `mem` variables from the caller's scope, mirroring
# `collect_linux_metrics`.
function collect_darwin_metrics() {
  local load
  load="$(one_minute_load)" || load=''

  local sysctl_out
  if ! sysctl_out="$(LC_ALL=C sysctl -n hw.logicalcpu hw.memsize 2> /dev/null)"; then
    return 0
  fi

  local cpu_count_line mem_size_line
  {
    IFS= read -r cpu_count_line
    IFS= read -r mem_size_line
  } <<< "${sysctl_out}"

  local cpus
  if [[ -n "${load}" ]] && parse_uint "${cpu_count_line}" && cpus="${REPLY}" && ((cpus > 0)); then
    cpu="$(cpu_percent_from_load "${load}" "${cpus}")" || cpu=''
  fi

  local mem_bytes
  if parse_uint "${mem_size_line}" && mem_bytes="${REPLY}" && ((mem_bytes > 0)); then
    local vm_stat_out
    if vm_stat_out="$(LC_ALL=C vm_stat 2> /dev/null)"; then
      mem="$(darwin_memory_percent_from_vm_stat "${mem_bytes}" <<< "${vm_stat_out}")" || mem=''
    fi
  fi
}

# Echo the 1-minute load average, or return non-zero if it cannot be determined.
#
# LC_ALL=C stops `uptime` from rendering the number with a locale-specific
# decimal separator; the comma substitution below is a second guard for any
# platform that ignores it.
function one_minute_load() {
  local uptime_out
  uptime_out="$(LC_ALL=C uptime 2> /dev/null)" || return 1

  parse_uptime_load "${uptime_out}"
}

function parse_uptime_load() {
  local uptime_out="$1"

  [[ "${uptime_out}" =~ load[[:space:]]+averages?:[[:space:]]*([0-9]+([.,][0-9]+)?) ]] \
    || return 1

  printf '%s' "${BASH_REMATCH[1]/,/.}"
}

# Convert a dot-decimal load string (e.g. "25.56") to integer hundredths
# (e.g. 2556), without floating point. Rejects overlong integer parts so the
# arithmetic below cannot overflow.
function load_to_hundredths() {
  local load="$1"

  [[ "${load}" =~ ^([0-9]+)(\.([0-9]+))?$ ]] || return 1

  local int_part="${BASH_REMATCH[1]}"
  local frac_part="${BASH_REMATCH[3]}"

  ((${#int_part} <= 6)) || return 1

  frac_part="${frac_part:0:2}"
  while ((${#frac_part} < 2)); do
    frac_part="${frac_part}0"
  done

  REPLY="$((10#${int_part} * 100 + 10#${frac_part}))"
}

# CPU percent is the half-up rounded `100 * load / cpus`, computed as
# `(2 * hundredths + cpus) / (2 * cpus)` since `hundredths` is already
# `100 * load`. May exceed 100.
function cpu_percent_from_load() {
  local load="$1" cpus="$2"

  load_to_hundredths "${load}" || return 1
  local hundredths="${REPLY}"

  parse_uint "${cpus}" || return 1
  cpus="${REPLY}"
  ((cpus > 0)) || return 1

  printf '%s' "$(((2 * hundredths + cpus) / (2 * cpus)))"
}

function linux_cpu_count() {
  linux_cpu_count_from_file /sys/devices/system/cpu/online
}

function linux_cpu_count_from_file() {
  local path="$1"

  local online_line
  IFS= read -r online_line 2> /dev/null < "${path}" || return 1

  linux_cpu_count_from_online "${online_line}"
}

# Count logical CPUs from a comma-separated list of `N` or `N-M` decimal
# items, e.g. `0-63` or `0-3,8-11`. Rejects empty input, non-digits,
# reversed ranges, and dangling `-` or `,`.
function linux_cpu_count_from_online() {
  local line="$1"

  [[ -n "${line}" ]] || return 1
  [[ "${line}" =~ ^[0-9,-]+$ ]] || return 1
  [[ "${line}" != *,,* && "${line}" != ,* && "${line}" != *, ]] || return 1
  [[ "${line}" != *--* && "${line}" != -* && "${line}" != *- ]] || return 1

  local IFS=','
  local items
  read -ra items <<< "${line}"
  local item total=0

  for item in "${items[@]}"; do
    if [[ "${item}" =~ ^([0-9]+)-([0-9]+)$ ]]; then
      local lo hi
      lo="$((10#${BASH_REMATCH[1]}))"
      hi="$((10#${BASH_REMATCH[2]}))"
      ((hi >= lo)) || return 1
      total=$((total + hi - lo + 1))
    elif [[ "${item}" =~ ^[0-9]+$ ]]; then
      total=$((total + 1))
    else
      return 1
    fi
  done

  ((total > 0)) || return 1
  printf '%s' "${total}"
}

function linux_memory_percent() {
  linux_memory_percent_from_file /proc/meminfo
}

function linux_memory_percent_from_file() {
  local meminfo_path="$1"

  linux_memory_percent_from_meminfo 2> /dev/null < "${meminfo_path}"
}

function linux_memory_percent_from_meminfo() {
  local key value rest
  local mem_total=''
  local mem_available=''

  while IFS=' :' read -r key value rest; do
    case "${key}" in
    MemTotal)
      mem_total="${value}"
      ;;
    MemAvailable)
      mem_available="${value}"
      ;;
    esac

    [[ -n "${mem_total}" && -n "${mem_available}" ]] && break
  done

  parse_uint "${mem_total}" || return 1
  mem_total="${REPLY}"
  parse_uint "${mem_available}" || return 1
  mem_available="${REPLY}"

  ((mem_total > 0)) || return 1
  ((mem_available <= mem_total)) || return 1

  # Linux MemAvailable estimates RAM available to new applications without
  # swapping, accounting for reclaimable cache and kernel reserves. Memory use
  # here is physical RAM minus that availability estimate, excluding swap.
  round_half_up_percent "$((mem_total - mem_available))" "${mem_total}"
}

function darwin_memory_percent_from_vm_stat() {
  parse_uint "$1" || return 1
  local physical_bytes="${REPLY}"
  ((physical_bytes > 0)) || return 1

  local line
  local page_size=''
  local anonymous=''
  local purgeable=''
  local wired=''
  local compressor=''

  while IFS= read -r line; do
    if [[ -z "${page_size}" \
      && "${line}" =~ page[[:space:]]+size[[:space:]]+of[[:space:]]+([0-9]+)[[:space:]]+bytes ]]; then
      page_size="${BASH_REMATCH[1]}"
      continue
    fi

    if [[ "${line}" =~ ^Anonymous[[:space:]]+pages:[[:space:]]*([0-9]+)\.?[[:space:]]*$ ]]; then
      anonymous="${BASH_REMATCH[1]}"
    elif [[ "${line}" =~ ^Pages[[:space:]]+purgeable:[[:space:]]*([0-9]+)\.?[[:space:]]*$ ]]; then
      purgeable="${BASH_REMATCH[1]}"
    elif [[ "${line}" =~ ^Pages[[:space:]]+wired[[:space:]]+down:[[:space:]]*([0-9]+)\.?[[:space:]]*$ ]]; then
      wired="${BASH_REMATCH[1]}"
    elif [[ "${line}" =~ ^Pages[[:space:]]+occupied[[:space:]]+by[[:space:]]+compressor:[[:space:]]*([0-9]+)\.?[[:space:]]*$ ]]; then
      compressor="${BASH_REMATCH[1]}"
    elif [[ "${line}" =~ ^Pages[[:space:]]+used[[:space:]]+by[[:space:]]+VM[[:space:]]+compressor:[[:space:]]*([0-9]+)\.?[[:space:]]*$ ]]; then
      compressor="${BASH_REMATCH[1]}"
    fi
  done

  parse_uint "${page_size}" || return 1
  page_size="${REPLY}"
  parse_uint "${anonymous}" || return 1
  anonymous="${REPLY}"
  parse_uint "${purgeable}" || return 1
  purgeable="${REPLY}"
  parse_uint "${wired}" || return 1
  wired="${REPLY}"
  parse_uint "${compressor}" || return 1
  compressor="${REPLY}"

  ((page_size > 0)) || return 1
  ((purgeable <= anonymous)) || return 1

  # macOS memory use is resident, non-purgeable anonymous memory plus wired RAM
  # and RAM occupied by compressed pages. This excludes file-backed cache,
  # purgeable anonymous pages, swap, and logical pages stored in the compressor.
  local used_pages used_bytes
  used_pages="$((anonymous - purgeable + wired + compressor))"
  used_bytes="$((used_pages * page_size))"

  ((used_bytes <= physical_bytes)) || return 1

  round_half_up_percent "${used_bytes}" "${physical_bytes}"
}

# Sets REPLY to the parsed value rather than printing it, since this is
# called many times per run and printing would fork a subshell per call.
function parse_uint() {
  local raw="$1"

  [[ "${raw}" =~ ^[[:space:]]*([0-9]+)[[:space:]]*$ ]] || return 1

  REPLY="$((10#${BASH_REMATCH[1]}))"
}

function round_half_up_percent() {
  local used="$1"
  local total="$2"

  ((total > 0)) || return 1
  ((used >= 0)) || return 1
  ((used <= total)) || return 1

  printf '%s' "$(((200 * used + total) / (2 * total)))"
}

# Style for a metric value at the given thresholds: healthy below `warn`,
# warning from `warn` through `crit - 1`, critical at `crit` and above. Sets
# REPLY rather than printing, to avoid forking a subshell per call.
function level_style() {
  local value="$1" warn="$2" crit="$3"

  if ((value >= crit)); then
    REPLY="${STYLE_CRIT}"
  elif ((value >= warn)); then
    REPLY="${STYLE_WARN}"
  else
    REPLY="${STYLE_HEALTHY}"
  fi
}

# Pure formatter: given the cpu and mem integer percents (or empty strings
# when unavailable), render the tmux status markup. Prints nothing when both
# are empty.
function render_segment() {
  local cpu="$1" mem="$2"
  local parts=''

  if [[ -n "${cpu}" ]]; then
    level_style "${cpu}" "${CPU_WARN_THRESHOLD}" "${CPU_CRIT_THRESHOLD}"
    parts="#[${STYLE_LABEL}]cpu #[${REPLY}]${cpu}%"
  fi

  if [[ -n "${mem}" ]]; then
    level_style "${mem}" "${MEM_WARN_THRESHOLD}" "${MEM_CRIT_THRESHOLD}"
    local mem_part="#[${STYLE_LABEL}]mem #[${REPLY}]${mem}%"

    if [[ -n "${parts}" ]]; then
      parts="${parts} ${mem_part}"
    else
      parts="${mem_part}"
    fi
  fi

  [[ -n "${parts}" ]] || return 0

  printf ' %s#[default]' "${parts}"
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  run "$@"
fi
