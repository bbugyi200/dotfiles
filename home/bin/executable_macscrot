#!/usr/bin/env bash
#
# Capture an interactively-selected screen region on the MacBook and upload it
# to both tailnet Linux hosts (apollo and athena) in parallel. SASE prompts
# later fetch the most recent uploads with the `#sshot` xprompt.

set -euo pipefail

SSH_OPTS=(-o BatchMode=yes -o ConnectTimeout=8 -o ConnectionAttempts=1)
SCREENCAPTURE_BIN="${SCREENCAPTURE_BIN:-/usr/sbin/screencapture}"

# Copy a string to the macOS clipboard. Returns nonzero if pbcopy is missing or
# the copy fails, so the caller can decide how to degrade.
copy_to_clipboard() {
	local text="$1"
	local pbcopy_bin
	if [[ -x /usr/bin/pbcopy ]]; then
		pbcopy_bin=/usr/bin/pbcopy
	elif command -v pbcopy >/dev/null 2>&1; then
		pbcopy_bin=pbcopy
	else
		return 1
	fi
	printf '%s' "$text" | "$pbcopy_bin"
}

# Show a macOS notification titled "Screenshot uploaded" with the given subtitle
# and message. Dynamic strings are passed as argv (read via `on run argv`)
# instead of interpolated into AppleScript source, so paths/quotes/spaces never
# need escaping. Returns nonzero if osascript is missing or fails.
notify_upload_finished() {
	local subtitle="$1"
	local message="$2"
	local osascript_bin
	if [[ -x /usr/bin/osascript ]]; then
		osascript_bin=/usr/bin/osascript
	elif command -v osascript >/dev/null 2>&1; then
		osascript_bin=osascript
	else
		return 1
	fi
	"$osascript_bin" -e 'on run argv
	display notification (item 2 of argv) with title "Screenshot uploaded" subtitle (item 1 of argv)
end run' "$subtitle" "$message"
}

upload_to_host() {
	local host="$1"
	ssh "${SSH_OPTS[@]}" "$host" "mkdir -p ~/${remote_dir}"
	scp "${SSH_OPTS[@]}" -p "$local_path" "${host}:~/${remote_path}"
}

screenshot_dir="$HOME/tmp/screenshots"
remote_dir="tmp/screenshots"

mkdir -p "$screenshot_dir"

timestamp="$(date +"%Y%m%d_%H%M%S")"
basename="${timestamp}.png"
local_path="${screenshot_dir}/${basename}"
remote_path="${remote_dir}/${basename}"

capture_region="${1:-}"
if [[ $# -gt 1 ]]; then
	echo "usage: macscrot [x,y,w,h]" >&2
	exit 2
fi
if [[ -n "$capture_region" && ! "$capture_region" =~ ^-?[0-9]+,-?[0-9]+,[0-9]+,[0-9]+$ ]]; then
	echo "macscrot: invalid region '${capture_region}' (expected x,y,w,h)" >&2
	exit 2
fi

# macOS native capture. Without a region, keep the original interactive
# crosshair behavior. With a region, capture the exact rectangle preselected by
# Hammerspoon. screencapture exits 0 even when the user cancels interactive
# capture, so we also check for an empty/missing output file below. Tolerate a
# nonzero exit so the cleanup-and-fail path runs regardless under `set -e`.
if [[ -n "$capture_region" ]]; then
	"$SCREENCAPTURE_BIN" -R "$capture_region" -t png "$local_path" || true
else
	"$SCREENCAPTURE_BIN" -i -t png "$local_path" || true
fi

if [[ ! -s "$local_path" ]]; then
	# Cancelled selection, or capture produced nothing — clean up the stub.
	rm -f "$local_path"
	echo "macscrot: capture cancelled or empty, nothing uploaded" >&2
	exit 1
fi

apollo_status=0
athena_status=0
upload_to_host apollo &
apollo_pid=$!
upload_to_host athena &
athena_pid=$!
wait "$apollo_pid" || apollo_status=$?
wait "$athena_pid" || athena_status=$?

ok_hosts=()
fail_hosts=()
if [[ "$apollo_status" -eq 0 ]]; then
	ok_hosts+=(apollo)
else
	fail_hosts+=(apollo)
	echo "macscrot: warning: upload to apollo failed (exit ${apollo_status})" >&2
fi
if [[ "$athena_status" -eq 0 ]]; then
	ok_hosts+=(athena)
else
	fail_hosts+=(athena)
	echo "macscrot: warning: upload to athena failed (exit ${athena_status})" >&2
fi

if [[ ${#ok_hosts[@]} -eq 0 ]]; then
	echo "macscrot: upload failed on apollo and athena" >&2
	exit 1
fi

clipboard_path="~/tmp/screenshots/${basename}"

clipboard_ok=1
if ! copy_to_clipboard "$clipboard_path"; then
	clipboard_ok=0
	echo "macscrot: warning: could not copy path to clipboard" >&2
fi

subtitle=""
case "${ok_hosts[*]}" in
"apollo athena")
	subtitle="Apollo + Athena"
	;;
apollo)
	subtitle="Apollo"
	;;
athena)
	subtitle="Athena"
	;;
esac

if [[ "$clipboard_ok" -eq 1 ]]; then
	notification_message="Path copied: ${clipboard_path}"
else
	notification_message="Upload succeeded; clipboard copy failed"
fi
if [[ ${#fail_hosts[@]} -gt 0 ]]; then
	notification_message="${notification_message}; ${fail_hosts[*]} failed"
fi

if ! notify_upload_finished "$subtitle" "$notification_message"; then
	echo "macscrot: warning: could not show notification" >&2
fi

echo "local:  ${local_path}"
for host in "${ok_hosts[@]}"; do
	echo "${host}: ~/${remote_path}"
done
if [[ "$clipboard_ok" -eq 1 ]]; then
	echo "clipboard: ${clipboard_path}"
fi
