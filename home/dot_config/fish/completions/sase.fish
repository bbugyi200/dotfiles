function __sase_cmd
    set -l current (__sase_path)
    test "$current" = "$argv[1]"
end

function __sase_path
    set -l tokens (commandline -opc)
    set -l path /
    set -l i 2
    set -l n (count $tokens)
    while test $i -le $n
        set -l w $tokens[$i]
        set i (math $i + 1)
        if test "$w" = --
            echo -n //remainder
            return
        end
        if string match -q -- '--*=*' $w
            continue
        end
        if string match -q -- '-*' $w
            if __sase_opt_takes_value "$path" "$w"
                if test $i -le $n
                    set i (math $i + 1)
                end
            end
            continue
        end
        set -l child (__sase_child "$path" "$w")
        if test -n "$child"
            set path $child
        end
    end
    echo -n "$path"
end

