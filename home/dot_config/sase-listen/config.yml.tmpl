# sase-listen config, managed by chezmoi (rollout sase-1g7.4)
narrator: gemini
engines:
  gemini:
    # Only the tool-specific env var may override the pass-managed key. Generic
    # GEMINI_API_KEY / GOOGLE_API_KEY exported for other tools must never shadow
    # it: a stale one on athena broke every research audio render with
    # HTTP 400 API_KEY_INVALID.
    api_key_env: [SASE_LISTEN_GEMINI_API_KEY]
    api_key_command: pass show gemini_cli_api_key
feed:
  host: apollo
  host_ssh: [apollo, apollo-do]
  dir: ~/.local/share/sase-listen/feed
  base_url: https://apollo.tail297af1.ts.net:8443
  {{- /* apollo's non-interactive feed receiver reads the provisioned token file. */}}{{- if eq .chezmoi.hostname "apollo" }}
  # feed receive runs over non-interactive SSH, where pinentry cannot prompt; the OOM-killed gpg-agent lost its cache on 2026-10-17.
  # This file is a mode-600 copy of pass show sase_listen_feed_token.
  # This follows the ~/.sase/telegram_bot_token precedent.
  token_command: cat {{ .chezmoi.homeDir }}/.sase/sase_listen_feed_token
  {{- else }}
  token_command: pass show sase_listen_feed_token
  {{- end }}
  title: SASE Listen
  auto_publish: true
