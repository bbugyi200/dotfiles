#!/bin/bash

# CHEZMOI WILL RUN THIS SCRIPT MONTHLY: {{ output "date" "+%Y-%m" | trim }}

source ~/.local/share/chezmoi/lib/chezmoi_utils.sh

LUAROCKS_VERSION=3.11.1
LUAROCKS_LUA_VERSION=5.1

# Install a Lua 5.1 interpreter (and its headers), which the luarocks build
# needs in order to configure itself against Lua 5.1 -- the version Neovim
# embeds and the one our rocks are installed for.
function install_lua51() {
  # The interpreter names that `./configure --lua-version=5.1` searches $PATH
  # for, checked the same way configure checks them.
  local lua_bin
  for lua_bin in lua5.1 lua51 lua-5.1 lua-51 luajit lua; do
    command -v "$lua_bin" &>/dev/null || continue
    if [[ "$("$lua_bin" -e 'print(_VERSION:match(" (5%.[1234])$"))' 2>/dev/null)" == "5.1" ]]; then
      return 0
    fi
  done

  chez::log "INSTALLING LUA 5.1 (REQUIRED TO BUILD LUAROCKS)"
  if command -v apt-get &>/dev/null; then
    if ! chez::can_sudo; then
      chez::log "WARNING: LUA 5.1 INSTALL NEEDS SUDO, BUT SUDO CANNOT RUN WITHOUT PROMPTING IN THIS CONTEXT"
      return 1
    fi
    sudo apt-get update && sudo apt-get install -y lua5.1 liblua5.1-0-dev
  elif command -v brew &>/dev/null; then
    brew install luajit
  else
    chez::log "NO LUA 5.1 INTERPRETER FOUND AND NO KNOWN PACKAGE MANAGER TO INSTALL ONE"
    return 1
  fi
}

# Install luarocks.
function install_luarocks() {
  install_lua51 || return 1

  chez::log "INSTALLING LUAROCKS VERSION %s" "$LUAROCKS_VERSION"

  # Build from a clean directory so a failed run cannot leave a half-configured
  # source tree (or a pile of wget's .tar.gz.N duplicates) behind.
  local build_dir="$(chez::build_dir_root)"/luarocks
  rm -rf "$build_dir"
  mkdir -p "$build_dir"
  pushd "$build_dir" &>/dev/null || return 1

  # Download and install luarocks.
  local rc=0
  local tarball=luarocks-$LUAROCKS_VERSION.tar.gz
  wget -O "$tarball" https://luarocks.org/releases/"$tarball" &&
    tar zxpf "$tarball" &&
    cd luarocks-$LUAROCKS_VERSION &&
    ./configure --lua-version=5.1 --prefix="$HOME/.local" &&
    make &&
    make install || rc=1

  popd &>/dev/null || return 1
  if [[ "$rc" -eq 0 && -x "$HOME"/.local/bin/luarocks && -x /usr/local/bin/luarocks ]]; then
    chez::log "/usr/local/bin/luarocks is now shadowed by ~/.local/bin/luarocks and can be removed with a reviewed /sase_sudo request"
  fi
  return "$rc"
}

# Uses luarocks to install the required rocks.
function install_rocks() {
  local -a failed_rocks=()
  local -a failed_statuses=()

  local rock
  local rock_rc
  for rock in busted nlua llscheck luacheck luacov; do
    chez::log "INSTALLING ROCK: %s" "$rock"
    luarocks --lua-version="$LUAROCKS_LUA_VERSION" install --local "$rock"
    rock_rc=$?
    if [[ "$rock_rc" -eq 0 ]]; then
      continue
    fi

    failed_rocks+=("$rock")
    failed_statuses+=("$rock_rc")
    printf 'LuaRocks install failed for %s (exit status %s).\n' \
      "$rock" "$rock_rc" >&2
  done

  if [[ "${#failed_rocks[@]}" -eq 0 ]]; then
    return 0
  fi

  printf '\nLuaRocks failed to install required rocks in %s/.luarocks:\n' \
    "$HOME" >&2

  local idx
  for idx in "${!failed_rocks[@]}"; do
    printf '  - %s (exit status %s). Retry: luarocks --lua-version=%s install --local %s\n' \
      "${failed_rocks[$idx]}" \
      "${failed_statuses[$idx]}" \
      "$LUAROCKS_LUA_VERSION" \
      "${failed_rocks[$idx]}" >&2
  done

  return 1
}

# Installs luarocks and then installs the required rocks.
function install_luarocks_and_rocks() {
  if ! command -v luarocks &>/dev/null; then
    # Bail out instead of running every `luarocks install` against a luarocks
    # that was never built (which wipes ~/.luarocks and then fails with 127).
    install_luarocks || return 1
  fi
  install_rocks
}

install_luarocks_and_rocks
chez::exit_install "$?"
